{
  "name": "rider-api",
  "version": "4.0.1",
  "private": true,
  "type": "commonjs",
  "dependencies": {
    "@apollo/server": "4.12.2",
    "@aws-sdk/client-s3": "3.886.0",
    "@bull-board/api": "6.12.0",
    "@bull-board/express": "6.12.0",
    "@bull-board/nestjs": "6.12.0",
    "@googlemaps/google-maps-services-js": "3.4.2",
    "@googlemaps/places": "2.0.1",
    "@googlemaps/routing": "2.0.1",
    "@nestjs/apollo": "13.1.0",
    "@nestjs/axios": "4.0.1",
    "@nestjs/bullmq": "11.0.3",
    "@nestjs/common": "11.1.5",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.5",
    "@nestjs/graphql": "13.1.0",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.5",
    "@nestjs/typeorm": "11.0.0",
    "@nestjs/websockets": "11.1.3",
    "@ptc-org/nestjs-query-graphql": "9.1.0",
    "@redis/search": "5.8.2",
    "@ridy/database": "*",
    "@sentry/nestjs": "10.0.0",
    "@sentry/profiling-node": "10.0.0",
    "@willsoto/nestjs-prometheus": "6.0.2",
    "axios": "1.10.0",
    "bullmq": "5.56.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "firebase-admin": "13.4.0",
    "form-data": "4.0.4",
    "graphql": "16.11.0",
    "graphql-redis-subscriptions": "2.7.0",
    "graphql-subscriptions": "3.0.0",
    "graphql-ws": "6.0.6",
    "h3-js": "4.2.1",
    "ioredis": "5.7.0",
    "jwt-decode": "4.0.0",
    "license-verify": "0.1.5",
    "multer": "2.0.2",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "plivo": "4.74.0",
    "prom-client": "15.1.3",
    "proper-url-join": "2.1.2",
    "redis": "5.8.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.3",
    "stripe": "18.4.0",
    "twilio": "5.7.2",
    "typeorm": "0.3.26"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "node-env=production"
          ]
        },
        "configurations": {
          "development": {
            "args": [
              "node-env=development"
            ]
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "rider-api:build",
          "runBuildTargetDependencies": false,
          "watch": true
        },
        "configurations": {
          "development": {
            "buildTarget": "rider-api:build:development"
          },
          "production": {
            "buildTarget": "build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "publish": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "bash tools/scripts/docker-backend-publish.sh --service rider-api --yes"
        }
      }
    }
  },
  "overrides": {
    "typescript": "5.8.3",
    "eslint": "^9.28.0",
    "rxjs": "7.8.2",
    "typeorm": {
      "redis": "^5.8.2"
    }
  },
  "main": "main.js"
}